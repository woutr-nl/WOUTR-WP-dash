<label><%= label %>
  <input name="<%= field %>" type="password" value="" autocomplete="new-password"
    placeholder="<%= stored ? 'opgeslagen — laat leeg om te behouden' : '' %>"><%- error %>
</label>
<% if (stored) { %>
  <div class="secret-actions">
    <button type="button" class="secondary" data-reveal="/sites/<%= site.id %>/reveal/<%= field %>" data-target="<%= field %>_shown">Toon</button>
    <input id="<%= field %>_shown" readonly hidden aria-label="<%= label %> (getoond)">
    <label class="inline"><input type="checkbox" name="<%= field %>_clear" value="1"> Wissen</label>
  </div>
<% } %>
