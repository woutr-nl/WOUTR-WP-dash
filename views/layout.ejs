<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · WOUTR-WP dashboard</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <header>
    <a class="brand" href="/">WOUTR-WP dashboard</a>
    <% if (loggedIn) { %>
      <nav>
        <a href="/ssh-key">SSH-sleutel</a>
        <a href="/instellingen">Instellingen</a>
        <form method="post" action="/logout"><button type="submit" class="link">Uitloggen</button></form>
      </nav>
    <% } %>
  </header>
  <main>
<%- body %>
  </main>
  <script>
    document.addEventListener('submit', (e) => {
      const msg = e.target.dataset.confirm;
      if (msg && !confirm(msg)) e.preventDefault();
    });
    // "Toon": fetch the decrypted secret on explicit request only.
    document.querySelectorAll('button[data-reveal]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const out = document.getElementById(btn.dataset.target);
        const res = await fetch(btn.dataset.reveal, { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        out.value = res.ok ? data.value : (data.error ?? 'Kon niet ophalen');
        out.hidden = false;
      });
    });
    document.querySelectorAll('button[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(document.getElementById(btn.dataset.target).value);
        const label = btn.textContent;
        btn.textContent = 'Gekopieerd';
        setTimeout(() => { btn.textContent = label; }, 1500);
      });
    });
    // Test/action buttons: the message is shown as text; the optional key-page link is static markup.
    document.querySelectorAll('button[data-test]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const out = document.getElementById(btn.dataset.target);
        const link = document.getElementById(btn.dataset.link);
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Bezig…';
        out.hidden = true;
        if (link) link.hidden = true;
        const res = await fetch(btn.dataset.test, { method: 'POST' }).catch(() => null);
        const data = res ? await res.json().catch(() => ({})) : {};
        out.textContent = data.message ?? data.error ?? 'Test kon niet worden uitgevoerd.';
        out.className = data.ok ? 'badge success' : 'error';
        out.hidden = false;
        if (link) link.hidden = data.outcome !== 'denied';
        btn.disabled = false;
        btn.textContent = label;
      });
    });
  </script>
</body>
</html>
