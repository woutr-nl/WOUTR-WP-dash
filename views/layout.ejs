<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · WOUTR-WP dashboard</title>
  <link rel="stylesheet" href="/public/style.css">
</head>
<body>
  <header>
    <a class="brand" href="/">WOUTR-WP dashboard</a>
    <% if (loggedIn) { %>
      <nav>
        <a href="/meldingen">Meldingen<% if (locals.meldingen > 0) { %> <span class="badge failed"><%= meldingen %></span><% } %></a>
        <a href="/ssh-key">SSH-sleutel</a>
        <a href="/instellingen">Instellingen</a>
        <form method="post" action="/logout"><button type="submit" class="link">Uitloggen</button></form>
      </nav>
    <% } %>
  </header>
  <main>
<%- body %>
  </main>
  <script>
    document.addEventListener('submit', (e) => {
      const msg = e.target.dataset.confirm;
      if (msg && !confirm(msg)) e.preventDefault();
    });
    // "Toon": fetch the decrypted secret on explicit request only.
    document.querySelectorAll('button[data-reveal]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const out = document.getElementById(btn.dataset.target);
        const res = await fetch(btn.dataset.reveal, { method: 'POST' });
        const data = await res.json().catch(() => ({}));
        out.value = res.ok ? data.value : (data.error ?? 'Kon niet ophalen');
        out.hidden = false;
      });
    });
    document.querySelectorAll('button[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(document.getElementById(btn.dataset.target).value);
        const label = btn.textContent;
        btn.textContent = 'Gekopieerd';
        setTimeout(() => { btn.textContent = label; }, 1500);
      });
    });
    // Test/action buttons: the message is shown as text; the optional key-page link is static markup.
    document.querySelectorAll('button[data-test]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const out = document.getElementById(btn.dataset.target);
        const link = document.getElementById(btn.dataset.link);
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Bezig…';
        out.hidden = true;
        if (link) link.hidden = true;
        const res = await fetch(btn.dataset.test, { method: 'POST' }).catch(() => null);
        const data = res ? await res.json().catch(() => ({})) : {};
        out.textContent = data.message ?? data.error ?? 'Test kon niet worden uitgevoerd.';
        out.className = data.ok ? 'badge success' : 'error';
        out.hidden = false;
        if (link) link.hidden = data.outcome !== 'denied';
        btn.disabled = false;
        btn.textContent = label;
      });
    });
    // SSL request: re-issue over a valid certificate only after confirm(); data-show-after is unhidden on success.
    document.querySelectorAll('button[data-ssl]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const out = document.getElementById(btn.dataset.target);
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Bezig…';
        out.hidden = true;
        const send = async (body) => {
          const res = await fetch(btn.dataset.ssl, { method: 'POST', body }).catch(() => null);
          return res ? res.json().catch(() => ({})) : {};
        };
        let data = await send();
        if (data.needs_confirmation) {
          if (!confirm(data.message)) {
            btn.disabled = false;
            btn.textContent = label;
            return;
          }
          data = await send(new URLSearchParams({ confirm: '1' }));
        }
        out.textContent = data.message ?? data.error ?? 'SSL-aanvraag kon niet worden uitgevoerd.';
        out.className = data.ok ? 'badge success' : 'error';
        out.hidden = false;
        const after = btn.dataset.showAfter && document.getElementById(btn.dataset.showAfter);
        if (data.ok && after) after.hidden = false;
        btn.disabled = false;
        btn.textContent = label;
      });
    });
    // WordPress login: the one-time URL only goes to window.open, never into the DOM or console.
    document.querySelectorAll('button[data-wp-login]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const out = document.getElementById(btn.dataset.target);
        const label = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Bezig…';
        out.hidden = true;
        const res = await fetch(btn.dataset.wpLogin, { method: 'POST' }).catch(() => null);
        const data = res ? await res.json().catch(() => ({})) : {};
        let error = null;
        if (data.ok && /^https:\/\//.test(data.login_url)) {
          // No 'noopener' feature: it makes window.open return null, hiding a blocked pop-up. Cut opener by hand.
          const w = window.open(data.login_url, '_blank');
          if (w) w.opener = null;
          else error = 'De pop-up is geblokkeerd; sta pop-ups toe voor dit dashboard.';
        } else error = data.message ?? data.error ?? 'Inloglink aanmaken mislukt.';
        if (error) {
          out.textContent = error;
          out.className = 'error';
          out.hidden = false;
        }
        btn.disabled = false;
        btn.textContent = label;
      });
    });
  </script>
</body>
</html>
