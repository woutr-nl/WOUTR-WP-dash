<div class="bar">
  <h1>Meldingen</h1>
</div>
<% const row = (n) => (n.run_id ? { href: `/sites/${n.site_id}/runs/${n.run_id}`, text: 'Bekijk run' } : { href: `/sites/${n.site_id}/runs`, text: 'Bekijk site' }); %>
<h2>Open</h2>
<% if (!open.length) { %>
  <p class="empty">Geen open meldingen.</p>
<% } else { %>
  <table class="sites">
    <thead><tr><th>Site</th><th>Ernst</th><th>Melding</th><th>Sinds</th><th></th></tr></thead>
    <tbody>
    <% for (const n of open) { const link = row(n); %>
      <tr>
        <td data-label="Site"><a href="/sites/<%= n.site_id %>/runs"><%= n.site_title %></a></td>
        <td data-label="Ernst"><span class="badge <%= HEALTH_STATUS[n.severity].badge %>"><%= HEALTH_STATUS[n.severity].label %></span></td>
        <td data-label="Melding"><%= n.message %></td>
        <td data-label="Sinds"><small>sinds <%= fmtDate(n.created_at) %></small></td>
        <td class="actions">
          <a class="button secondary" href="<%= link.href %>"><%= link.text %></a>
          <form method="post" action="/meldingen/<%= n.id %>/afvinken"><button type="submit" class="secondary">Afvinken</button></form>
        </td>
      </tr>
    <% } %>
    </tbody>
  </table>
<% } %>
<h2>Opgelost en afgevinkt (laatste 30 dagen)</h2>
<% if (!closed.length) { %>
  <p class="empty">Geen opgeloste of afgevinkte meldingen.</p>
<% } else { %>
  <table class="sites">
    <thead><tr><th>Site</th><th>Ernst</th><th>Melding</th><th>Sinds</th><th>Afgehandeld</th><th></th></tr></thead>
    <tbody>
    <% for (const n of closed) { const link = row(n); %>
      <tr>
        <td data-label="Site"><a href="/sites/<%= n.site_id %>/runs"><%= n.site_title %></a></td>
        <td data-label="Ernst"><span class="badge <%= HEALTH_STATUS[n.severity].badge %>"><%= HEALTH_STATUS[n.severity].label %></span></td>
        <td data-label="Melding"><%= n.message %></td>
        <td data-label="Sinds"><small>sinds <%= fmtDate(n.created_at) %></small></td>
        <td data-label="Afgehandeld"><small><%= n.dismissed_at ? `afgevinkt ${fmtDate(n.dismissed_at)}` : `opgelost ${fmtDate(n.resolved_at)}` %></small></td>
        <td class="actions"><a class="button secondary" href="<%= link.href %>"><%= link.text %></a></td>
      </tr>
    <% } %>
    </tbody>
  </table>
<% } %>
